{
  "name": "@hierophant/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "report:delete": "node --env-file=.env.local scripts/delete-report.mjs",
    "research:launch": "esbuild src/research/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=.research/cli.mjs --log-level=warning && node --env-file=.env.local .research/cli.mjs",
    "cf:deploy": "bash scripts/deploy-cloudflare.sh"
  },
  "dependencies": {
    "@hierophant/engine": "workspace:*",
    "@hierophant/intel": "workspace:*",
    "@opennextjs/cloudflare": "1.20.18",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.9.2",
    "gsap": "^3.15.1",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "4.166.0"
  }
}
