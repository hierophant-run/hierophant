# Public URL of the site. Leave empty during local development.
NEXT_PUBLIC_SITE_URL=

# Public URL of the docs subdomain. Leave empty to serve docs from /docs.
NEXT_PUBLIC_DOCS_URL=

# Public address for security reports and report removal requests.
# /.well-known/security.txt returns 404 until this is set.
NEXT_PUBLIC_CONTACT_EMAIL=

# Cloudflare Turnstile. Leave both empty to keep the bot check off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Fine-grained GitHub token with read access to public repositories.
# Without it, GitHub allows far fewer requests per hour.
GITHUB_TOKEN=

# Postgres connection string. Use the pooled connection on serverless hosts.
DATABASE_URL=
